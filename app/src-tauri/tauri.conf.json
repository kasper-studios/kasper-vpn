{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KasperVPN",
  "version": "0.1.0",
  "identifier": "io.kasperia.kasper-vpn",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "KasperVPN · Цитадель",
        "width": 1120,
        "height": 800,
        "minWidth": 760,
        "minHeight": 640,
        "backgroundColor": "#090912"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "KasperVPN split-tunnel desktop client",
    "category": "Utility",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
